<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>bleak.Data.Anonymizer</PackageId>
    <Version>1.0.0</Version>
    <Authors>Jamal Khan</Authors>
    <Company>bleak LLC</Company>
    <Copyright>bleak LLC</Copyright>
    <Description>Config-driven PII anonymizer for large delimited files: fake names, emails, phones, dates, addresses, GUIDs and more.</Description>
    <PackageTags>anonymize;pii;csv;privacy;fake-data</PackageTags>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/jamalkhan/bleak.Data.Anonymizer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jamalkhan/bleak.Data.Anonymizer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="bleak.Data.InfiniteDataLoader" Version="1.0.0" />
  </ItemGroup>

</Project>
